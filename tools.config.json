{
  "validate-commit": {
    "types": ["feat", "fix", "build", "chore", "ci", "docs", "style", "refactor", "perf", "test", "revert"],
    "scopes": {
      "tools": ["color-scale", "log", "procs", "shiki-zed-parity", "sudo", "tmux", "trpc"],
      "shared": ["utils"],
      "repo": ["config", "deps"]
    },
    "maxLength": 72
  }
}
