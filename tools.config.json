{
  "validate-commit": {
    "types": ["feat", "fix", "build", "chore", "ci", "docs", "style", "refactor", "perf", "test", "revert"],
    "scopes": {
      "tools": ["color-scale", "log", "mutate", "playwright-debug", "procs", "seqdiag", "shiki-zed-parity", "sudo", "tagline", "test-report", "tmux", "todo", "trpc"],
      "shared": ["utils"],
      "repo": ["config", "deps"]
    },
    "maxLength": 72
  }
}
