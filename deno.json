{
  "workspace": [
    "./color-scale",
    "./procs",
    "./shiki-zed-parity",
    "./sudo",
    "./tmux",
    "./trpc"
  ],
  "tasks": {
    "test": "deno test --allow-read",
    "install-hooks": "(test -d ../tools/validate-commit/hooks || (echo 'install-hooks needs onclick-coop/tools cloned at ../tools' >&2 && exit 1)) && git config core.hooksPath \"$(realpath ../tools/validate-commit/hooks)\"",
    "color-scale": "deno run --allow-read --allow-env=INIT_CWD color-scale/main.ts",
    "procs": "deno run --allow-read --allow-env=INIT_CWD --allow-run=gprocs procs/main.ts",
    "shiki-zed-parity": "deno run --allow-read --allow-env=VSCODE_TEXTMATE_DEBUG shiki-zed-parity/main.ts",
    "sudo": "deno run --allow-write --allow-env=SUDO_ASKPASS,INIT_CWD --allow-run=sudo sudo/main.ts",
    "tmux": "deno run --allow-read --allow-env=INIT_CWD --allow-run=tmux tmux/main.ts",
    "trpc": "deno run --allow-read --allow-write=\"$HOME/.trpc\" --allow-env=HOME,INIT_CWD --allow-net trpc/main.ts"
  },
  "fmt": {
    "lineWidth": 240,
    "semiColons": false,
    "singleQuote": true,
    "exclude": [
      ".claude/",
      ".zed/",
      "*.md",
      "**/*.md"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.6",
    "shiki": "npm:shiki@4.4.3",
    "zod": "npm:zod@^4.6.5"
  }
}
